# Settings for compose.yml in this folder. Write values as they are, without quotes.

# The Sim i image (ghcr.io/tamingit/sim-i): a release channel (prod, beta), a version, or a branch's name. It needs
# the developer and code-server support, and carries the VS Code extension code-server installs.
SIM_I_TAG=prod

# The developer: in the administrators' group (SIMADMIN), the only user code-server lets in, and an administrator
# in GreenGlow. Sim i sets this password at each start: change it here, not in Sim i.
SIM_I_DEVELOPER_USER=dev
SIM_I_DEVELOPER_PASSWORD=ChangeMe!

# Who owns ./source on this machine (id -u, id -g): code-server writes files as them. After changing these, rebuild
# (docker compose up --build) and remove the volume sim-i-examples_code-server-home.
SIM_I_UID=1002
SIM_I_GID=1002

# git in code-server, when ./source is a repository of its own: the name and email on commits, and a private key
# for SSH remotes (readable by SIM_I_UID only).
SIM_I_GIT_NAME=
SIM_I_GIT_EMAIL=
# SIM_I_GIT_SSH_KEY=/home/you/.ssh/sim-i-deploy-key

# GreenGlow (ghcr.io/tamingit/greenglow): an image that serves under /terminal/ and signs people on with Sim i's
# users, and its break-glass administrator's password, used once, on its first start.
GREENGLOW_TAG=prod
GREENGLOW_BREAKGLASS_PASSWORD=ChangeMe!123456

# Where it's published: the address (127.0.0.1 for this machine only, 0.0.0.0 for every interface), the web
# address's port and that address as the browser has it, and PostgreSQL's port.
SIM_I_HOST=127.0.0.1
SIM_I_WEB_PUBLISHED_PORT=8080
SIM_I_PUBLIC_URL=http://localhost:8080

# Plain HTTP is the default, and all Sim i needs. Optionally, HTTPS on a self-signed certificate: set SIM_I_SITE to https:// and the address as the browser has it, with the
# published port (https://sim-i.lan:8080, or https://192.168.1.50:8080; several, separated by ", "), SIM_I_CERTS to
# local_certs, and SIM_I_PUBLIC_URL to that address too. Then trust the certificate on each computer that uses it,
# from <address>/sim-i-ca.crt: README.md, HTTPS. Plain HTTP: SIM_I_SITE=:8080 and SIM_I_CERTS empty.
# Reached by an IP address: set SIM_I_DEFAULT_SNI to it too (browsers don't name an IP address when they connect).
SIM_I_SITE=:8080
SIM_I_CERTS=
SIM_I_DEFAULT_SNI=localhost
SIM_I_DB_PUBLISHED_PORT=5432

# No test user (PRTUSER) here: uncomment these to have one.
# SIM_I_USER=PRTUSER
# SIM_I_PASSWORD=ChangeMe!
