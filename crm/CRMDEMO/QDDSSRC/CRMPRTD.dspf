     A* CRMPRTD - Print reports window (24 x 80)
     A                                      DSPSIZ(24 80 *DS3)
     A                                      INDARA
     A                                      CA12
     A*
     A          R DUMMY                     ASSUME
     A                                  1  2' '
     A*
     A          R PRTWDW                    WINDOW(5 12 12 54)
     A                                      WDWBORDER((*COLOR BLU) (*DSPATR    -
     A                                      RI) (*CHAR '        '))
     A                                      WDWTITLE((*TEXT 'Print reports')   -
     A                                      (*COLOR WHT))
     A                                  2  2'Report'
     A            PRPT           1A  B  2 16
     A  51                                  DSPATR(RI PC)
     A                                  2 19'1=Customer directory'
     A                                  3 19'2=Pipeline by stage'
     A                                  5  2'Output queue'
     A            POUTQ         10A  B  5 16
     A  52                                  DSPATR(RI PC)
     A                                  5 28'*JOB = job default'
     A                                  6  2'Hold spool'
     A            PHOLD          1A  B  6 16
     A  53                                  DSPATR(RI PC)
     A                                  6 28'(Y/N)'
     A                                  9  2'Enter=Print    F12=Cancel'
     A                                      COLOR(BLU)
     A            PMSG          50A  O 10  2COLOR(WHT)
